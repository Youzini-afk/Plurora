{
  "$defs": {
    "ArtifactDescriptor": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "artifact_type_uri": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_type_uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "ProtocolRequirement": {
      "properties": {
        "profiles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "protocol_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "protocol_id",
        "version"
      ],
      "type": "object"
    },
    "RightDisposition": {
      "enum": [
        "allowed",
        "denied",
        "requires_entitlement",
        "unspecified"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "backup": {
      "$ref": "#/$defs/RightDisposition"
    },
    "copy_across_hosts": {
      "$ref": "#/$defs/RightDisposition"
    },
    "dedicated_server": {
      "$ref": "#/$defs/RightDisposition"
    },
    "derive": {
      "$ref": "#/$defs/RightDisposition"
    },
    "entitlement_requirements": {
      "items": {
        "$ref": "#/$defs/ProtocolRequirement"
      },
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactDescriptor"
      },
      "type": "array"
    },
    "execute": {
      "$ref": "#/$defs/RightDisposition"
    },
    "export_state": {
      "$ref": "#/$defs/RightDisposition"
    },
    "install": {
      "$ref": "#/$defs/RightDisposition"
    },
    "license_expression": {
      "type": [
        "string",
        "null"
      ]
    },
    "modding": {
      "$ref": "#/$defs/RightDisposition"
    },
    "modify": {
      "$ref": "#/$defs/RightDisposition"
    },
    "redistribute_artifacts": {
      "$ref": "#/$defs/RightDisposition"
    },
    "terms_uri": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "backup",
    "copy_across_hosts",
    "dedicated_server",
    "derive",
    "execute",
    "export_state",
    "install",
    "modding",
    "modify",
    "redistribute_artifacts"
  ],
  "title": "RightsDeclaration",
  "type": "object"
}

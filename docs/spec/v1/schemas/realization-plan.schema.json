{
  "$defs": {
    "ArtifactDescriptor": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "artifact_type_uri": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_type_uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "BindingPhase": {
      "enum": [
        "authoring",
        "installation",
        "launch",
        "runtime"
      ],
      "type": "string"
    },
    "BuildAction": {
      "properties": {
        "action_id": {
          "type": "string"
        },
        "builder_id": {
          "type": "string"
        },
        "input_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "output_id": {
          "type": "string"
        },
        "parameter_ref": {
          "$ref": "#/$defs/ArtifactDescriptor"
        }
      },
      "required": [
        "action_id",
        "builder_id",
        "node_id",
        "output_id",
        "parameter_ref"
      ],
      "type": "object"
    },
    "ChangePrecondition": {
      "properties": {
        "expected": {
          "default": null
        },
        "kind": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "EndpointAction": {
      "properties": {
        "action_id": {
          "type": "string"
        },
        "endpoint_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/SelectedTransport"
        },
        "visibility": {
          "$ref": "#/$defs/EndpointVisibility"
        }
      },
      "required": [
        "action_id",
        "endpoint_id",
        "target_id",
        "transport",
        "visibility"
      ],
      "type": "object"
    },
    "EndpointVisibility": {
      "enum": [
        "private",
        "shared",
        "public"
      ],
      "type": "string"
    },
    "InstallationId": {
      "format": "uuid",
      "type": "string"
    },
    "LaunchAction": {
      "properties": {
        "action_id": {
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "parameter_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_id": {
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "artifact",
        "node_id",
        "target_id"
      ],
      "type": "object"
    },
    "NodeId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "NodePlacement": {
      "properties": {
        "execution_class": {
          "type": "string"
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "placement_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        }
      },
      "required": [
        "execution_class",
        "node_id",
        "placement_id",
        "target_id"
      ],
      "type": "object"
    },
    "PortEndpoint": {
      "properties": {
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "port_id": {
          "$ref": "#/$defs/PortId"
        }
      },
      "required": [
        "node_id",
        "port_id"
      ],
      "type": "object"
    },
    "PortId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "SelectedTransport": {
      "properties": {
        "class_id": {
          "type": "string"
        },
        "properties": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "class_id"
      ],
      "type": "object"
    },
    "StateAction": {
      "properties": {
        "action_id": {
          "type": "string"
        },
        "input_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/StateActionKind"
        },
        "state_slot_id": {
          "$ref": "#/$defs/StateSlotId"
        },
        "target_id": {
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "kind",
        "state_slot_id",
        "target_id"
      ],
      "type": "object"
    },
    "StateActionKind": {
      "enum": [
        "provision",
        "attach",
        "snapshot",
        "restore",
        "migrate"
      ],
      "type": "string"
    },
    "StateSlotId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "TransportBindingPlan": {
      "properties": {
        "binding_id": {
          "type": "string"
        },
        "consumer": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "consumer_target_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/BindingPhase"
        },
        "provider": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "provider_target_id": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/SelectedTransport"
        }
      },
      "required": [
        "binding_id",
        "consumer",
        "consumer_target_id",
        "phase",
        "provider",
        "provider_target_id",
        "transport"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assembly_lock": {
      "$ref": "#/$defs/ArtifactDescriptor"
    },
    "build_actions": {
      "items": {
        "$ref": "#/$defs/BuildAction"
      },
      "type": "array"
    },
    "endpoint_actions": {
      "items": {
        "$ref": "#/$defs/EndpointAction"
      },
      "type": "array"
    },
    "installation_id": {
      "$ref": "#/$defs/InstallationId"
    },
    "inventory_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactDescriptor"
      },
      "type": "array"
    },
    "launch_actions": {
      "items": {
        "$ref": "#/$defs/LaunchAction"
      },
      "type": "array"
    },
    "operational_intent": {
      "$ref": "#/$defs/ArtifactDescriptor"
    },
    "placements": {
      "items": {
        "$ref": "#/$defs/NodePlacement"
      },
      "type": "array"
    },
    "preconditions": {
      "items": {
        "$ref": "#/$defs/ChangePrecondition"
      },
      "type": "array"
    },
    "required_authority": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "risk_summary": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "const": "plurora.realization-plan.v1",
      "type": "string"
    },
    "state_actions": {
      "items": {
        "$ref": "#/$defs/StateAction"
      },
      "type": "array"
    },
    "transports": {
      "items": {
        "$ref": "#/$defs/TransportBindingPlan"
      },
      "type": "array"
    },
    "work_revision": {
      "$ref": "#/$defs/ArtifactDescriptor"
    }
  },
  "required": [
    "assembly_lock",
    "installation_id",
    "inventory_refs",
    "operational_intent",
    "required_authority",
    "schema",
    "work_revision"
  ],
  "title": "RealizationPlan",
  "type": "object"
}

{
  "$defs": {
    "ArtifactDescriptor": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "artifact_type_uri": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_type_uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "PortId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "WorkEntrypoint": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "intent_uri": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/WorkEntrypointTarget"
        }
      },
      "required": [
        "id",
        "intent_uri",
        "target"
      ],
      "type": "object"
    },
    "WorkEntrypointTarget": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "assembly_port"
              ],
              "type": "string"
            },
            "port_id": {
              "$ref": "#/$defs/PortId"
            }
          },
          "required": [
            "kind",
            "port_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "surface"
              ],
              "type": "string"
            },
            "surface_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "surface_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "foreign_launch"
              ],
              "type": "string"
            },
            "launch_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "launch_id"
          ],
          "type": "object"
        }
      ]
    },
    "WorkId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "annotations": {
      "additionalProperties": true,
      "type": "object"
    },
    "assembly": {
      "$ref": "#/$defs/ArtifactDescriptor"
    },
    "content_roots": {
      "items": {
        "$ref": "#/$defs/ArtifactDescriptor"
      },
      "type": "array"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "entrypoints": {
      "items": {
        "$ref": "#/$defs/WorkEntrypoint"
      },
      "type": "array"
    },
    "operational_intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        {
          "type": "null"
        }
      ]
    },
    "rights": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "const": "plurora.work-revision.v1",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "transparency": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        {
          "type": "null"
        }
      ]
    },
    "work_id": {
      "$ref": "#/$defs/WorkId"
    }
  },
  "required": [
    "assembly",
    "schema",
    "title",
    "work_id"
  ],
  "title": "WorkRevision",
  "type": "object"
}

        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "port_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"

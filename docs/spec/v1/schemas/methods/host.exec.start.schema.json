          "allOf": [
            {
              "$ref": "#/$defs/ExecResourceLimits"
            }
          ],
          "default": {
            "max_cpu_millis": null,
            "max_duration_ms": null,
            "max_log_bytes": null,
            "max_memory_mb": null

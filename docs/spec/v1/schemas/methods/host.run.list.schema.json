{
  "$defs": {
    "ActiveBindingRecord": {
      "properties": {
        "authority_handle_id": {
          "type": "string"
        },
        "binding_id": {
          "$ref": "#/$defs/BindingId"
        },
        "consumer_installation_id": {
          "$ref": "#/$defs/InstallationId"
        },
        "consumer_port": {
          "$ref": "#/$defs/PortId"
        },
        "expires_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "exposure_id": {
          "$ref": "#/$defs/ExposureId"
        },
        "transport": {
          "$ref": "#/$defs/SelectedTransport"
        }
      },
      "required": [
        "authority_handle_id",
        "binding_id",
        "consumer_installation_id",
        "consumer_port",
        "exposure_id",
        "transport"
      ],
      "type": "object"
    },
    "ArtifactDescriptor": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "artifact_type_uri": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_type_uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "BindingId": {
      "format": "uuid",
      "type": "string"
    },
    "Errors": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string"
          },
          "details": true,
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "details",
          "message"
        ],
        "title": "ErrorShape",
        "type": "object"
      },
      "type": "array"
    },
    "ExposureId": {
      "format": "uuid",
      "type": "string"
    },
    "HealthStatus": {
      "enum": [
        "unknown",
        "healthy",
        "degraded",
        "unhealthy"
      ],
      "type": "string"
    },
    "InstallationId": {
      "format": "uuid",
      "type": "string"
    },
    "NodeId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "NodeInstanceRecord": {
      "properties": {
        "instance_id": {
          "type": "string"
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "realization_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RealizationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/NodeInstanceStatus"
        }
      },
      "required": [
        "instance_id",
        "node_id",
        "status"
      ],
      "type": "object"
    },
    "NodeInstanceStatus": {
      "enum": [
        "starting",
        "running",
        "degraded",
        "stopping",
        "stopped",
        "failed",
        "interrupted"
      ],
      "type": "string"
    },
    "Params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "installation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstallationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunStatus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "RunListRequest",
      "type": "object"
    },
    "PortId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "RealizationId": {
      "format": "uuid",
      "type": "string"
    },
    "Result": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "entrypoint_id": {
            "type": "string"
          },
          "installation_revision": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "record": {
            "$ref": "#/$defs/RunRecord"
          },
          "revision": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          }
        },
        "required": [
          "entrypoint_id",
          "installation_revision",
          "record",
          "revision"
        ],
        "title": "RunView",
        "type": "object"
      },
      "type": "array"
    },
    "RunHealth": {
      "properties": {
        "diagnostic_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/HealthStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "RunId": {
      "format": "uuid",
      "type": "string"
    },
    "RunRecord": {
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/ActiveBindingRecord"
          },
          "type": "array"
        },
        "context_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "health": {
          "$ref": "#/$defs/RunHealth"
        },
        "installation_id": {
          "$ref": "#/$defs/InstallationId"
        },
        "node_instances": {
          "items": {
            "$ref": "#/$defs/NodeInstanceRecord"
          },
          "type": "array"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "stopped_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "health",
        "installation_id",
        "run_id",
        "started_at",
        "status"
      ],
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "starting",
        "running",
        "degraded",
        "stopping",
        "stopped",
        "failed",
        "interrupted"
      ],
      "type": "string"
    },
    "SelectedTransport": {
      "properties": {
        "class_id": {
          "type": "string"
        },
        "properties": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "class_id"
      ],
      "type": "object"
    }
  },
  "$id": "urn:plurora:schema:method:host.run.list:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Plurora public platform method host.run.list.",
  "properties": {
    "errors": {
      "$ref": "#/$defs/Errors"
    },
    "method": {
      "const": "host.run.list"
    },
    "params": {
      "$ref": "#/$defs/Params"
    },
    "result": {
      "$ref": "#/$defs/Result"
    }
  },
  "required": [
    "method",
    "params"
  ],
  "title": "host.run.list",
  "type": "object",
  "x-plurora-contract": {
    "id": "host.run.list",
    "implementation_status": "implemented",
    "introduced_in": "plurora.contract.default/v1@0.1.0",
    "maturity": "candidate",
    "owner_layer": "host",
    "request_schema": "urn:plurora:schema:method:host.run.list:v1#/$defs/Params",
    "response_schema": "urn:plurora:schema:method:host.run.list:v1#/$defs/Result",
    "streaming": false
  }
}

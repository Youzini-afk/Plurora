          "code",
          "details",
          "message"
        ],
        "title": "ErrorShape",
        "type": "object"
      },
      "type": "array"
    },
    "Params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "EmptyParams",
      "type": "object"
    },
    "ProxyProtocol": {

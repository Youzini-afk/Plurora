          "id": {
            "type": "string"
          },
          "iframe_url": {
            "type": "string"
          },
          "protocol": {
            "$ref": "#/$defs/ProxyProtocol"
          },
          "public_url": {
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/$defs/ProxyRouteStatusKind"
          },
          "upstream": {
            "$ref": "#/$defs/ProxyRouteUpstream"
          }
        },
        "required": [
          "id",
          "iframe_url",
          "protocol",
          "public_url",
          "ready",
          "status",
          "upstream"
        ],
        "title": "ProxyRouteRecord",
        "type": "object"
      },
      "type": "array"
    }

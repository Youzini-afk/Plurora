{
  "$defs": {
    "ArtifactDescriptor": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "artifact_type_uri": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_type_uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "AssetContentEncoding": {
      "description": "Encoding used by the public `object.put` and `object.get` content field.",
      "enum": [
        "utf8",
        "hex"
      ],
      "type": "string"
    },
    "AssetGetParams": {
      "additionalProperties": false,
      "description": "Original ordinary-Asset selector for `object.get`.",
      "properties": {
        "asset_id": {
          "type": "string"
        }
      },
      "required": [
        "asset_id"
      ],
      "type": "object"
    },
    "AssetGetResponse": {
      "additionalProperties": false,
      "description": "Original ordinary-Asset result for `object.get`.",
      "properties": {
        "content": {
          "type": "string"
        },
        "record": {
          "$ref": "#/$defs/AssetRecord"
        }
      },
      "required": [
        "content",
        "record"
      ],
      "type": "object"
    },
    "AssetRecord": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "descriptor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "hash": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "metadata": {
          "default": null
        },
        "mime": {
          "type": "string"
        },
        "origin_package_id": {
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "created_at",
        "hash",
        "id",
        "mime",
        "origin_package_id",
        "size_bytes"
      ],
      "type": "object"
    },
    "Errors": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string"
          },
          "details": true,
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "details",
          "message"
        ],
        "title": "ErrorShape",
        "type": "object"
      },
      "type": "array"
    },
    "InstallationStateArtifactGetParams": {
      "additionalProperties": false,
      "description": "Audit-only selector for a journal-issued Installation state artifact.",
      "properties": {
        "installation_state_artifact": {
          "$ref": "#/$defs/ArtifactDescriptor"
        }
      },
      "required": [
        "installation_state_artifact"
      ],
      "type": "object"
    },
    "InstallationStateArtifactGetResponse": {
      "additionalProperties": false,
      "description": "Audit-only result for a journal-issued Installation state artifact.",
      "properties": {
        "content": {
          "type": "string"
        },
        "content_encoding": {
          "$ref": "#/$defs/AssetContentEncoding"
        },
        "descriptor": {
          "$ref": "#/$defs/ArtifactDescriptor"
        }
      },
      "required": [
        "content",
        "content_encoding",
        "descriptor"
      ],
      "type": "object"
    },
    "Params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "$ref": "#/$defs/AssetGetParams"
        },
        {
          "$ref": "#/$defs/InstallationStateArtifactGetParams"
        }
      ],
      "title": "ObjectGetRequest"
    },
    "Result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "$ref": "#/$defs/AssetGetResponse"
        },
        {
          "$ref": "#/$defs/InstallationStateArtifactGetResponse"
        }
      ],
      "title": "ObjectGetResponse"
    }
  },
  "$id": "urn:plurora:schema:method:object.get:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Plurora public platform method object.get.",
  "properties": {
    "errors": {
      "$ref": "#/$defs/Errors"
    },
    "method": {
      "const": "object.get"
    },
    "params": {
      "$ref": "#/$defs/Params"
    },
    "result": {
      "$ref": "#/$defs/Result"
    }
  },
  "required": [
    "method",
    "params"
  ],
  "title": "object.get",
  "type": "object",
  "x-plurora-contract": {
    "id": "object.get",
    "implementation_status": "partial",
    "introduced_in": "plurora.contract.default/v1@0.1.0",
    "maturity": "experimental",
    "owner_layer": "substrate",
    "request_schema": "urn:plurora:schema:method:object.get:v1#/$defs/Params",
    "response_schema": "urn:plurora:schema:method:object.get:v1#/$defs/Result",
    "streaming": false
  }
}

{
  "$defs": {
    "ArtifactDescriptor": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "artifact_type_uri": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_type_uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "AssetContentEncoding": {
      "description": "Encoding used by the public `object.put` and `object.get` content field.",
      "enum": [
        "utf8",
        "hex"
      ],
      "type": "string"
    },
    "AssetRecord": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "descriptor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "hash": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "metadata": {
          "default": null
        },
        "mime": {
          "type": "string"
        },
        "origin_package_id": {
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "created_at",
        "hash",
        "id",
        "mime",
        "origin_package_id",
        "size_bytes"
      ],
      "type": "object"
    },
    "Errors": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string"
          },
          "details": true,
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "details",
          "message"
        ],
        "title": "ErrorShape",
        "type": "object"
      },
      "type": "array"
    },
    "ExactArtifactUpload": {
      "additionalProperties": false,
      "description": "Explicit request contract for transporting an exact portable artifact.",
      "properties": {
        "content_encoding": {
          "$ref": "#/$defs/AssetContentEncoding"
        },
        "descriptor": {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        "scope": {
          "$ref": "#/$defs/ObjectPutScope"
        }
      },
      "required": [
        "content_encoding",
        "descriptor",
        "scope"
      ],
      "type": "object"
    },
    "InstallationId": {
      "format": "uuid",
      "type": "string"
    },
    "ObjectPutScope": {
      "description": "Installation mutation which may consume an exact portable artifact upload.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "installation_create"
              ],
              "type": "string"
            },
            "work_id": {
              "$ref": "#/$defs/WorkId"
            }
          },
          "required": [
            "kind",
            "work_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "installation_id": {
              "$ref": "#/$defs/InstallationId"
            },
            "kind": {
              "enum": [
                "installation_update"
              ],
              "type": "string"
            },
            "work_id": {
              "$ref": "#/$defs/WorkId"
            }
          },
          "required": [
            "installation_id",
            "kind",
            "work_id"
          ],
          "type": "object"
        }
      ]
    },
    "Params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifactUpload"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "type": "string"
        },
        "metadata": {
          "default": null
        },
        "mime": {
          "type": "string"
        },
        "origin_package_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "content",
        "mime"
      ],
      "title": "AssetPutRequest",
      "type": "object"
    },
    "Result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "descriptor": {
          "$ref": "#/$defs/ArtifactDescriptor"
        }
      },
      "required": [
        "asset",
        "descriptor"
      ],
      "title": "ObjectPutResponse",
      "type": "object"
    },
    "WorkId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)+$",
      "type": "string"
    }
  },
  "$id": "urn:plurora:schema:method:object.put:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Plurora public platform method object.put.",
  "properties": {
    "errors": {
      "$ref": "#/$defs/Errors"
    },
    "method": {
      "const": "object.put"
    },
    "params": {
      "$ref": "#/$defs/Params"
    },
    "result": {
      "$ref": "#/$defs/Result"
    }
  },
  "required": [
    "method",
    "params"
  ],
  "title": "object.put",
  "type": "object",
  "x-plurora-contract": {
    "id": "object.put",
    "implementation_status": "partial",
    "introduced_in": "plurora.contract.default/v1@0.1.0",
    "maturity": "experimental",
    "owner_layer": "substrate",
    "request_schema": "urn:plurora:schema:method:object.put:v1#/$defs/Params",
    "response_schema": "urn:plurora:schema:method:object.put:v1#/$defs/Result",
    "streaming": false
  }
}

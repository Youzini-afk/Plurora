{
  "$defs": {
    "AcquisitionKind": {
      "enum": [
        "work_bundle",
        "package",
        "git_snapshot",
        "local_import",
        "remote_catalog",
        "foreign_binding"
      ],
      "type": "string"
    },
    "AcquisitionRecord": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/AcquisitionKind"
        },
        "provenance_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "update_channel": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ArtifactDescriptor": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "artifact_type_uri": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_type_uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "ClaimStatus": {
      "enum": [
        "claimed",
        "verified",
        "refuted",
        "unknown"
      ],
      "type": "string"
    },
    "Errors": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string"
          },
          "details": true,
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "details",
          "message"
        ],
        "title": "ErrorShape",
        "type": "object"
      },
      "type": "array"
    },
    "InstallationId": {
      "format": "uuid",
      "type": "string"
    },
    "InstallationRecord": {
      "properties": {
        "assembly_lock": {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "installation_id": {
          "$ref": "#/$defs/InstallationId"
        },
        "schema_version": {
          "const": 1,
          "format": "uint16",
          "type": "integer"
        },
        "secret_policy": {
          "allOf": [
            {
              "$ref": "#/$defs/InstallationSecretPolicy"
            }
          ],
          "default": {
            "allow_platform_fallback": false
          }
        },
        "source": {
          "$ref": "#/$defs/AcquisitionRecord"
        },
        "state_bindings": {
          "items": {
            "$ref": "#/$defs/StateBindingRecord"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/InstallationStatus"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        },
        "work_revision": {
          "$ref": "#/$defs/ArtifactDescriptor"
        }
      },
      "required": [
        "assembly_lock",
        "created_at",
        "display_name",
        "installation_id",
        "schema_version",
        "source",
        "status",
        "updated_at",
        "work_revision"
      ],
      "type": "object"
    },
    "InstallationRollbackPointer": {
      "properties": {
        "assembly_lock": {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "state_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "work_revision": {
          "$ref": "#/$defs/ArtifactDescriptor"
        }
      },
      "required": [
        "assembly_lock",
        "revision",
        "work_revision"
      ],
      "type": "object"
    },
    "InstallationSecretPolicy": {
      "properties": {
        "allow_platform_fallback": {
          "default": false,
          "type": "boolean"
        },
        "allowed_secret_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "InstallationStatus": {
      "enum": [
        "resolving",
        "ready",
        "updating",
        "blocked",
        "failed",
        "removing",
        "removed"
      ],
      "type": "string"
    },
    "InstallationWorkSummary": {
      "additionalProperties": false,
      "description": "Host-projected discovery metadata from the exact, verified WorkRevision selected by an Installation. This is descriptive content, not authority.",
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "type": "object"
        },
        "content_roots": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "entrypoints": {
          "items": {
            "$ref": "#/$defs/WorkEntrypoint"
          },
          "type": "array"
        },
        "operational_intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "rights": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "rights_declaration": {
          "anyOf": [
            {
              "$ref": "#/$defs/RightsDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parsed declaration from the exact `rights` descriptor. Descriptive only; the Host still evaluates policy from verified artifact bytes at effect time."
        },
        "title": {
          "type": "string"
        },
        "transparency": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "transparency_declaration": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransparencyDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parsed declaration from the exact `transparency` descriptor. This keeps Library disclosure on the public Installation API without exposing a raw ObjectStore read primitive."
        },
        "work_id": {
          "$ref": "#/$defs/WorkId"
        }
      },
      "required": [
        "annotations",
        "content_roots",
        "description",
        "entrypoints",
        "title",
        "work_id"
      ],
      "type": "object"
    },
    "Params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstallationStatus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "InstallationListRequest",
      "type": "object"
    },
    "PortId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "ProtocolRequirement": {
      "properties": {
        "profiles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "protocol_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "protocol_id",
        "version"
      ],
      "type": "object"
    },
    "Result": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "record": {
            "$ref": "#/$defs/InstallationRecord"
          },
          "revision": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "rollback": {
            "anyOf": [
              {
                "$ref": "#/$defs/InstallationRollbackPointer"
              },
              {
                "type": "null"
              }
            ]
          },
          "work_summary": {
            "$ref": "#/$defs/InstallationWorkSummary"
          }
        },
        "required": [
          "record",
          "revision",
          "work_summary"
        ],
        "title": "InstallationView",
        "type": "object"
      },
      "type": "array"
    },
    "RightDisposition": {
      "enum": [
        "allowed",
        "denied",
        "requires_entitlement",
        "unspecified"
      ],
      "type": "string"
    },
    "RightsDeclaration": {
      "properties": {
        "backup": {
          "$ref": "#/$defs/RightDisposition"
        },
        "copy_across_hosts": {
          "$ref": "#/$defs/RightDisposition"
        },
        "dedicated_server": {
          "$ref": "#/$defs/RightDisposition"
        },
        "derive": {
          "$ref": "#/$defs/RightDisposition"
        },
        "entitlement_requirements": {
          "items": {
            "$ref": "#/$defs/ProtocolRequirement"
          },
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "execute": {
          "$ref": "#/$defs/RightDisposition"
        },
        "export_state": {
          "$ref": "#/$defs/RightDisposition"
        },
        "install": {
          "$ref": "#/$defs/RightDisposition"
        },
        "license_expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "modding": {
          "$ref": "#/$defs/RightDisposition"
        },
        "modify": {
          "$ref": "#/$defs/RightDisposition"
        },
        "redistribute_artifacts": {
          "$ref": "#/$defs/RightDisposition"
        },
        "terms_uri": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "backup",
        "copy_across_hosts",
        "dedicated_server",
        "derive",
        "execute",
        "export_state",
        "install",
        "modding",
        "modify",
        "redistribute_artifacts"
      ],
      "type": "object"
    },
    "SourceVisibility": {
      "enum": [
        "open",
        "source_available",
        "closed",
        "unknown"
      ],
      "type": "string"
    },
    "StateBindingKind": {
      "enum": [
        "host_managed",
        "external_provider"
      ],
      "type": "string"
    },
    "StateBindingRecord": {
      "properties": {
        "binding_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/StateBindingKind"
        },
        "provider_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_slot_id": {
          "$ref": "#/$defs/StateSlotId"
        }
      },
      "required": [
        "binding_id",
        "kind",
        "state_slot_id"
      ],
      "type": "object"
    },
    "StatePortability": {
      "enum": [
        "portable",
        "opaque_exportable",
        "host_bound",
        "external_authority"
      ],
      "type": "string"
    },
    "StateSlotId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "TransparencyDeclaration": {
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "provenance_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "reproducible_build_claim": {
          "$ref": "#/$defs/ClaimStatus"
        },
        "sbom_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "signature_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "source_visibility": {
          "$ref": "#/$defs/SourceVisibility"
        },
        "state_portability": {
          "$ref": "#/$defs/StatePortability"
        },
        "telemetry_disclosures": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "reproducible_build_claim",
        "source_visibility",
        "state_portability"
      ],
      "type": "object"
    },
    "WorkEntrypoint": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "intent_uri": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/WorkEntrypointTarget"
        }
      },
      "required": [
        "id",
        "intent_uri",
        "target"
      ],
      "type": "object"
    },
    "WorkEntrypointTarget": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "assembly_port"
              ],
              "type": "string"
            },
            "port_id": {
              "$ref": "#/$defs/PortId"
            }
          },
          "required": [
            "kind",
            "port_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "surface"
              ],
              "type": "string"
            },
            "surface_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "surface_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "foreign_launch"
              ],
              "type": "string"
            },
            "launch_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "launch_id"
          ],
          "type": "object"
        }
      ]
    },
    "WorkId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)+$",
      "type": "string"
    }
  },
  "$id": "urn:plurora:schema:method:host.installation.list:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Plurora public platform method host.installation.list.",
  "properties": {
    "errors": {
      "$ref": "#/$defs/Errors"
    },
    "method": {
      "const": "host.installation.list"
    },
    "params": {
      "$ref": "#/$defs/Params"
    },
    "result": {
      "$ref": "#/$defs/Result"
    }
  },
  "required": [
    "method",
    "params"
  ],
  "title": "host.installation.list",
  "type": "object",
  "x-plurora-contract": {
    "id": "host.installation.list",
    "implementation_status": "implemented",
    "introduced_in": "plurora.contract.default/v1@0.1.0",
    "maturity": "candidate",
    "owner_layer": "host",
    "request_schema": "urn:plurora:schema:method:host.installation.list:v1#/$defs/Params",
    "response_schema": "urn:plurora:schema:method:host.installation.list:v1#/$defs/Result",
    "streaming": false
  }
}

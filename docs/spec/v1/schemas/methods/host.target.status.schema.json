{
  "$defs": {
    "Errors": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string"
          },
          "details": true,
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "details",
          "message"
        ],
        "title": "ErrorShape",
        "type": "object"
      },
      "type": "array"
    },
    "ExecutionTargetCapability": {
      "enum": [
        "local_exec",
        "port_lease",
        "http_proxy_upstream",
        "websocket_proxy_upstream",
        "artifact_transfer",
        "declarative_verifier",
        "health_probe",
        "workload",
        "authenticated_tunnel"
      ],
      "type": "string"
    },
    "ExecutionTargetObservedSummary": {
      "properties": {
        "artifact_count": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "running_operation_count": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "workload_count": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ExecutionTargetReachability": {
      "enum": [
        "local_host",
        "direct",
        "reverse_tunnel"
      ],
      "type": "string"
    },
    "ExecutionTargetStatusKind": {
      "enum": [
        "enrolling",
        "available",
        "degraded",
        "offline",
        "draining",
        "incompatible",
        "revoked",
        "unavailable"
      ],
      "type": "string"
    },
    "Params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "target_id": {
          "type": "string"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "TargetIdParams",
      "type": "object"
    },
    "Result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "capabilities": {
          "default": [],
          "description": "Effective capabilities after protocol negotiation and Host policy.",
          "items": {
            "$ref": "#/$defs/ExecutionTargetCapability"
          },
          "type": "array"
        },
        "declared_capabilities": {
          "default": [],
          "description": "Capabilities declared by the target before Host policy is applied.",
          "items": {
            "$ref": "#/$defs/ExecutionTargetCapability"
          },
          "type": "array"
        },
        "enrolled_at_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "heartbeat_expires_at_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "identity_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "last_seen_at_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "lease_epoch": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionTargetObservedSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_epoch": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "protocol_versions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reachability": {
          "$ref": "#/$defs/ExecutionTargetReachability"
        },
        "revoked_at_ms": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "selected_protocol_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ExecutionTargetStatusKind"
        }
      },
      "required": [
        "id",
        "name",
        "reachability",
        "status"
      ],
      "title": "ExecutionTarget",
      "type": "object"
    }
  },
  "$id": "urn:plurora:schema:method:host.target.status:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Plurora public platform method host.target.status.",
  "properties": {
    "errors": {
      "$ref": "#/$defs/Errors"
    },
    "method": {
      "const": "host.target.status"
    },
    "params": {
      "$ref": "#/$defs/Params"
    },
    "result": {
      "$ref": "#/$defs/Result"
    }
  },
  "required": [
    "method",
    "params"
  ],
  "title": "host.target.status",
  "type": "object",
  "x-plurora-contract": {
    "id": "host.target.status",
    "implementation_status": "partial",
    "introduced_in": "plurora.contract.default/v1@0.1.0",
    "maturity": "experimental",
    "owner_layer": "host",
    "request_schema": "urn:plurora:schema:method:host.target.status:v1#/$defs/Params",
    "response_schema": "urn:plurora:schema:method:host.target.status:v1#/$defs/Result",
    "streaming": false
  }
}

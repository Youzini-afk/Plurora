{
  "$defs": {
    "Errors": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string"
          },
          "details": true,
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "details",
          "message"
        ],
        "title": "ErrorShape",
        "type": "object"
      },
      "type": "array"
    },
    "Params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project_id": {
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "ProjectIdParams",
      "type": "object"
    },
    "ProjectState": {
      "description": "Runtime project state. Not serialized to project.yaml; tracked by registry.",
      "oneOf": [
        {
          "description": "Installed but not running.",
          "enum": [
            "installed"
          ],
          "type": "string"
        },
        {
          "description": "Stopped after running.",
          "enum": [
            "stopped"
          ],
          "type": "string"
        },
        {
          "description": "Currently transitioning to running.",
          "enum": [
            "starting"
          ],
          "type": "string"
        },
        {
          "description": "Currently running and serving.",
          "enum": [
            "running"
          ],
          "type": "string"
        },
        {
          "description": "Currently transitioning to stopped.",
          "enum": [
            "stopping"
          ],
          "type": "string"
        },
        {
          "description": "Failed to start or crashed.",
          "enum": [
            "failed"
          ],
          "type": "string"
        },
        {
          "description": "Soft-deleted, awaiting cleanup.",
          "enum": [
            "archived"
          ],
          "type": "string"
        }
      ]
    },
    "ProjectStorageSummarySchema": {
      "properties": {
        "bundle_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cache_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "data_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "log_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "measured_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "measurement_state": {
          "$ref": "#/$defs/StorageMeasurementStateSchema"
        },
        "total_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "measurement_state"
      ],
      "type": "object"
    },
    "Result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "running_session_id": {
          "type": "string"
        },
        "secrets_count": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "sessions_count": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/ProjectState"
        },
        "storage_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectStorageSummarySchema"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "project_id",
        "running_session_id",
        "secrets_count",
        "sessions_count",
        "state"
      ],
      "title": "ProjectStatusResult",
      "type": "object"
    },
    "StorageMeasurementStateSchema": {
      "enum": [
        "measured",
        "unknown"
      ],
      "type": "string"
    }
  },
  "$id": "urn:plurora:schema:method:host.project.status:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Plurora public platform method host.project.status.",
  "properties": {
    "errors": {
      "$ref": "#/$defs/Errors"
    },
    "method": {
      "const": "host.project.status"
    },
    "params": {
      "$ref": "#/$defs/Params"
    },
    "result": {
      "$ref": "#/$defs/Result"
    }
  },
  "required": [
    "method",
    "params"
  ],
  "title": "host.project.status",
  "type": "object",
  "x-plurora-contract": {
    "id": "host.project.status",
    "implementation_status": "implemented",
    "introduced_in": "plurora.contract.default/v1@0.1.0",
    "maturity": "candidate",
    "owner_layer": "host",
    "request_schema": "urn:plurora:schema:method:host.project.status:v1#/$defs/Params",
    "response_schema": "urn:plurora:schema:method:host.project.status:v1#/$defs/Result",
    "streaming": false
  }
}

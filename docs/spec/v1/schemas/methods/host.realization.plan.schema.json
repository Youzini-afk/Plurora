            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "output_id": {
          "type": "string"
        },
        "parameter_ref": {
          "$ref": "#/$defs/ArtifactDescriptor"
        }
      },
      "required": [
        "action_id",
        "builder_id",
        "node_id",
        "output_id",
        "parameter_ref"
      ],
      "type": "object"
    },
    "ChangePrecondition": {
      "properties": {
        "expected": {
          "default": null
        },
        "kind": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "EndpointAction": {
      "properties": {
        "action_id": {
          "type": "string"
        },
        "endpoint_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/SelectedTransport"
        },
        "visibility": {
          "$ref": "#/$defs/EndpointVisibility"
        }
      },
      "required": [
        "action_id",
        "endpoint_id",
        "target_id",
        "transport",
        "visibility"
      ],
      "type": "object"
    },
    "EndpointVisibility": {
      "enum": [
        "private",
        "shared",
        "public"
      ],
      "type": "string"
    },
    "Errors": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string"
          },
          "details": true,
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "details",
          "message"
        ],

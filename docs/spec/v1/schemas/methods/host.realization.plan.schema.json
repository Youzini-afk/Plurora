        {
          "additionalProperties": false,
          "properties": {
            "build_context_ref": {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            "build_descriptor_hash": {
              "type": "string"
            },
            "container_port": {
              "format": "uint16",
              "minimum": 0.0,
              "type": "integer"
            },
            "dockerfile": {
              "type": "string"
            },
            "execution_class": {
              "type": "string"
            },
            "health_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "docker_build"
              ],
              "type": "string"
            },
            "network_mode": {
              "$ref": "#/$defs/ManagedTargetBuildNetworkMode"

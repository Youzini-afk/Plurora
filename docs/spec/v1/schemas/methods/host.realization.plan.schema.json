            "port_name": {
              "type": "string"
            },
            "route_access": {
              "allOf": [
                {
                  "$ref": "#/$defs/ProxyRouteAccess"
                }
              ],
              "default": "host_authenticated"
            },
            "route_id": {
              "type": "string"
            },
            "source_tree_digest": {
              "type": "string"
            },
            "workload_id": {
              "type": "string"
            },
            "workspace_id": {
              "$ref": "#/$defs/WorkspaceId"
            }
          },
          "required": [
            "build_context_ref",
            "build_descriptor_hash",
            "container_port",
            "dockerfile",
            "execution_class",
            "kind",
            "network_mode",
            "port_name",
            "route_id",
            "source_tree_digest",
            "workload_id",
            "workspace_id"
          ],
          "type": "object"
        }
      ]
    },
    "RealizationHealth": {
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"

    },
    "params": {
      "$ref": "#/$defs/Params"
    },
    "result": {
      "$ref": "#/$defs/Result"
    }
  },
  "required": [
    "method",
    "params"
  ],
  "title": "host.realization.plan",
  "type": "object",
  "x-plurora-contract": {
    "id": "host.realization.plan",
    "implementation_status": "implemented",

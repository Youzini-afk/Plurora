    "StateActionKind": {
      "enum": [
        "provision",
        "attach",
        "snapshot",
        "restore",
        "migrate"
      ],
      "type": "string"
    },
    "StateSlotId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "TransportBindingPlan": {
      "properties": {
        "binding_id": {
          "type": "string"
        },
        "consumer": {

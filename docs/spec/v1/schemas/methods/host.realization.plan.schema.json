            {
              "type": "null"
            }
          ]
        },
        "resource_id": {
          "type": "string"
        },
        "resource_type": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        }
      },
      "required": [
        "backend_id",
        "resource_id",
        "resource_type",
        "target_id"
      ],
      "type": "object"

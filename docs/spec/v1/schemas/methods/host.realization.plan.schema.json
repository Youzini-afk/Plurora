      "type": "array"
    },
    "HealthStatus": {
      "enum": [
        "unknown",
        "healthy",
        "degraded",
        "unhealthy"
      ],
      "type": "string"
    },
    "InstallationId": {
      "format": "uuid",
      "type": "string"
    },
    "LaunchAction": {
      "properties": {
        "action_id": {
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactDescriptor"

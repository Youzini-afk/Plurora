        "target_id": {
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "artifact",
        "node_id",
        "target_id"
      ],
      "type": "object"
    },
    "ManagedTargetBuildNetworkMode": {
      "enum": [
        "none",
        "bridge"
      ],
      "type": "string"
    },
    "NodeId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "NodePlacement": {
      "properties": {
        "execution_class": {
          "type": "string"
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "placement_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        }
      },
      "required": [
        "execution_class",
        "node_id",
        "placement_id",
        "target_id"
      ],
      "type": "object"
    },

        "consumer_target_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/BindingPhase"
        },
        "provider": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "provider_target_id": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/SelectedTransport"
        }
      },
      "required": [
        "binding_id",
        "consumer",
        "consumer_target_id",
        "phase",
        "provider",
        "provider_target_id",
        "transport"
      ],
      "type": "object"
    },
    "WorkspaceId": {
      "format": "uuid",
      "type": "string"
    }

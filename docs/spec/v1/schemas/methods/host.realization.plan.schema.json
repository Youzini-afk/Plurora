  "$id": "urn:plurora:schema:method:host.realization.plan:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Plurora public platform method host.realization.plan.",
  "properties": {

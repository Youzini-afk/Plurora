      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "backends": {
          "items": {
            "$ref": "#/$defs/RealizationBackendSelection"
          },
          "type": "array"
        },
        "expected_installation_revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "idempotency_key": {
          "type": "string"
        },
        "installation_id": {
          "$ref": "#/$defs/InstallationId"

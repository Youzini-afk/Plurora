      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "ProxyRouteAccess": {
      "enum": [
        "host_authenticated",
        "public"
      ],
      "type": "string"
    },
    "RealizationBackendSelection": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "container_port": {
              "format": "uint16",
              "minimum": 0.0,
              "type": "integer"
            },
            "execution_class": {
              "type": "string"
            },
            "health_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "image": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "oci_image"
              ],
              "type": "string"
            },
            "port_name": {
              "type": "string"
            },
            "pull_if_missing": {
              "default": false,
              "type": "boolean"
            },
            "route_access": {
              "allOf": [
                {
                  "$ref": "#/$defs/ProxyRouteAccess"
                }
              ],
              "default": "host_authenticated"
            },
            "route_id": {
              "type": "string"
            },
            "workload_id": {
              "type": "string"
            }

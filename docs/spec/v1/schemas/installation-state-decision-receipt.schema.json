{
  "$defs": {
    "ArtifactDescriptor": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "artifact_type_uri": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_type_uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "InstallationId": {
      "format": "uuid",
      "type": "string"
    },
    "InstallationStateDecision": {
      "enum": [
        "allow",
        "deny"
      ],
      "type": "string"
    },
    "InstallationStateDecisionAction": {
      "enum": [
        "reset",
        "replace"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/InstallationStateDecisionAction"
    },
    "authority_evidence": {
      "items": {
        "$ref": "#/$defs/ArtifactDescriptor"
      },
      "type": "array"
    },
    "candidate_lock_digest": {
      "type": "string"
    },
    "candidate_work_digest": {
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/InstallationStateDecision"
    },
    "expected_revision": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "installation_id": {
      "$ref": "#/$defs/InstallationId"
    },
    "operation": {
      "type": "string"
    },
    "replacement_snapshot_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "authority_evidence",
    "candidate_lock_digest",
    "candidate_work_digest",
    "decision",
    "expected_revision",
    "installation_id",
    "operation",
    "schema"
  ],
  "title": "InstallationStateDecisionReceipt",
  "type": "object"
}

{
  "$defs": {
    "ArtifactDescriptor": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "artifact_type_uri": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_type_uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "BackupPolicy": {
      "enum": [
        "required",
        "allowed",
        "forbidden"
      ],
      "type": "string"
    },
    "NodeId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "PortEndpoint": {
      "properties": {
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "port_id": {
          "$ref": "#/$defs/PortId"
        }
      },
      "required": [
        "node_id",
        "port_id"
      ],
      "type": "object"
    },
    "PortId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "StatePortability": {
      "enum": [
        "portable",
        "opaque_exportable",
        "host_bound",
        "external_authority"
      ],
      "type": "string"
    },
    "StateScope": {
      "enum": [
        "run",
        "installation",
        "user",
        "shared",
        "external"
      ],
      "type": "string"
    },
    "StateSlotId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "annotations": {
      "additionalProperties": true,
      "type": "object"
    },
    "backup_policy": {
      "$ref": "#/$defs/BackupPolicy"
    },
    "migration_port": {
      "anyOf": [
        {
          "$ref": "#/$defs/PortEndpoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_node_id": {
      "$ref": "#/$defs/NodeId"
    },
    "portability": {
      "$ref": "#/$defs/StatePortability"
    },
    "schema_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "$ref": "#/$defs/StateScope"
    },
    "state_slot_id": {
      "$ref": "#/$defs/StateSlotId"
    }
  },
  "required": [
    "backup_policy",
    "owner_node_id",
    "portability",
    "scope",
    "state_slot_id"
  ],
  "title": "StateSlotDescriptor",
  "type": "object"
}

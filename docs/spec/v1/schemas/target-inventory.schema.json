{
  "$defs": {
    "ArtifactDescriptor": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "artifact_type_uri": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_type_uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "ResourceCapacity": {
      "properties": {
        "cpu_millis": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "gpu_count": {
          "default": 0,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_workloads": {
          "default": 0,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "memory_bytes": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "storage_bytes": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "TargetCapabilityRecord": {
      "properties": {
        "available": {
          "type": "boolean"
        },
        "capability_id": {
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "properties": {
          "additionalProperties": true,
          "type": "object"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "available",
        "capability_id",
        "version"
      ],
      "type": "object"
    },
    "TopologyRelation": {
      "properties": {
        "latency_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "other_target_id": {
          "type": "string"
        },
        "properties": {
          "additionalProperties": true,
          "type": "object"
        },
        "relation_id": {
          "type": "string"
        }
      },
      "required": [
        "other_target_id",
        "relation_id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/TargetCapabilityRecord"
      },
      "type": "array"
    },
    "capacity": {
      "allOf": [
        {
          "$ref": "#/$defs/ResourceCapacity"
        }
      ],
      "default": {
        "cpu_millis": 0,
        "gpu_count": 0,
        "max_workloads": 0,
        "memory_bytes": 0,
        "storage_bytes": 0
      }
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "topology": {
      "items": {
        "$ref": "#/$defs/TopologyRelation"
      },
      "type": "array"
    },
    "trust_zone": {
      "type": "string"
    }
  },
  "required": [
    "observed_at",
    "target_id",
    "trust_zone"
  ],
  "title": "TargetInventorySnapshot",
  "type": "object"
}

{
  "$defs": {
    "ArtifactDescriptor": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "artifact_type_uri": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_type_uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "BindingLock": {
      "properties": {
        "binding_id": {
          "type": "string"
        },
        "consumer": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "phase": {
          "$ref": "#/$defs/BindingPhase"
        },
        "provider": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "provider_component": {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        "transport": {
          "$ref": "#/$defs/SelectedTransport"
        }
      },
      "required": [
        "binding_id",
        "consumer",
        "phase",
        "provider",
        "provider_component",
        "transport"
      ],
      "type": "object"
    },
    "BindingPhase": {
      "enum": [
        "authoring",
        "installation",
        "launch",
        "runtime"
      ],
      "type": "string"
    },
    "ComponentTrustClass": {
      "enum": [
        "sandboxed_component",
        "isolated_process",
        "remote_boundary",
        "trusted_native",
        "static_resource",
        "foreign_capsule"
      ],
      "type": "string"
    },
    "NodeId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "NodeLock": {
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        "behavior_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "trust_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentTrustClass"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifact",
        "node_id"
      ],
      "type": "object"
    },
    "PortEndpoint": {
      "properties": {
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "port_id": {
          "$ref": "#/$defs/PortId"
        }
      },
      "required": [
        "node_id",
        "port_id"
      ],
      "type": "object"
    },
    "PortId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "ProtocolProfilePin": {
      "properties": {
        "profile": {
          "type": "string"
        },
        "protocol_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "profile",
        "protocol_id",
        "version"
      ],
      "type": "object"
    },
    "SelectedTransport": {
      "properties": {
        "class_id": {
          "type": "string"
        },
        "properties": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "class_id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assembly": {
      "$ref": "#/$defs/ArtifactDescriptor"
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/BindingLock"
      },
      "type": "array"
    },
    "content_roots": {
      "items": {
        "$ref": "#/$defs/ArtifactDescriptor"
      },
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeLock"
      },
      "type": "array"
    },
    "protocol_profiles": {
      "items": {
        "$ref": "#/$defs/ProtocolProfilePin"
      },
      "type": "array"
    },
    "schema": {
      "const": "plurora.assembly-lock.v1",
      "type": "string"
    }
  },
  "required": [
    "assembly",
    "nodes",
    "schema"
  ],
  "title": "AssemblyLock",
  "type": "object"
}

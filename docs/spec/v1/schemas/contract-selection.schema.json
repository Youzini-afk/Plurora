{
  "$defs": {
    "ContractOwnerLayer": {
      "enum": [
        "substrate",
        "host",
        "protocol",
        "shell"
      ],
      "type": "string"
    },
    "ContractVersionRequirement": {
      "properties": {
        "layer": {
          "$ref": "#/$defs/ContractOwnerLayer"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "layer",
        "version"
      ],
      "type": "object"
    },
    "ProtocolSelection": {
      "properties": {
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "protocol_id",
        "version"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "profile": {
      "type": "string"
    },
    "protocols": {
      "items": {
        "$ref": "#/$defs/ProtocolSelection"
      },
      "type": "array"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/ContractVersionRequirement"
      },
      "type": "array"
    }
  },
  "required": [
    "profile"
  ],
  "title": "ContractSelection",
  "type": "object"
}

{
  "$defs": {
    "AvailabilityPolicy": {
      "enum": [
        "required",
        "degraded_without",
        "optional"
      ],
      "type": "string"
    },
    "BindingPhase": {
      "enum": [
        "authoring",
        "installation",
        "launch",
        "runtime"
      ],
      "type": "string"
    },
    "EffectClass": {
      "enum": [
        "pure",
        "deterministic_stateful",
        "recorded_nondeterministic",
        "external_effecting",
        "realtime_best_effort"
      ],
      "type": "string"
    },
    "PortContract": {
      "properties": {
        "interface_id": {
          "type": "string"
        },
        "profiles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "protocol_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "interface_id",
        "protocol_id",
        "version"
      ],
      "type": "object"
    },
    "PortId": {
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "PortMultiplicity": {
      "properties": {
        "max": {
          "format": "uint16",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "min": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "min"
      ],
      "type": "object"
    },
    "PortRole": {
      "oneOf": [
        {
          "properties": {
            "accepted_effects": {
              "items": {
                "$ref": "#/$defs/EffectClass"
              },
              "type": "array"
            },
            "availability": {
              "$ref": "#/$defs/AvailabilityPolicy"
            },
            "kind": {
              "enum": [
                "import"
              ],
              "type": "string"
            },
            "latest_binding_phase": {
              "$ref": "#/$defs/BindingPhase"
            },
            "multiplicity": {
              "$ref": "#/$defs/PortMultiplicity"
            }
          },
          "required": [
            "accepted_effects",
            "availability",
            "kind",
            "latest_binding_phase",
            "multiplicity"
          ],
          "type": "object"
        },
        {
          "properties": {
            "effect_class": {
              "$ref": "#/$defs/EffectClass"
            },
            "kind": {
              "enum": [
                "export"
              ],
              "type": "string"
            },
            "multiplicity": {
              "$ref": "#/$defs/PortMultiplicity"
            }
          },
          "required": [
            "effect_class",
            "kind",
            "multiplicity"
          ],
          "type": "object"
        }
      ]
    },
    "TransportRequirements": {
      "properties": {
        "allowed_classes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "extensions": {
          "additionalProperties": true,
          "type": "object"
        },
        "large_payload": {
          "default": false,
          "type": "boolean"
        },
        "local_only": {
          "default": false,
          "type": "boolean"
        },
        "max_latency_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "ordered": {
          "default": false,
          "type": "boolean"
        },
        "reliable": {
          "default": false,
          "type": "boolean"
        },
        "same_process": {
          "default": false,
          "type": "boolean"
        },
        "shared_memory_allowed": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "annotations": {
      "additionalProperties": true,
      "type": "object"
    },
    "contract": {
      "$ref": "#/$defs/PortContract"
    },
    "interaction": {
      "type": "string"
    },
    "port_id": {
      "$ref": "#/$defs/PortId"
    },
    "role": {
      "$ref": "#/$defs/PortRole"
    },
    "transport": {
      "allOf": [
        {
          "$ref": "#/$defs/TransportRequirements"
        }
      ],
      "default": {
        "large_payload": false,
        "local_only": false,
        "ordered": false,
        "reliable": false,
        "same_process": false,
        "shared_memory_allowed": false
      }
    }
  },
  "required": [
    "contract",
    "interaction",
    "port_id",
    "role"
  ],
  "title": "PortDescriptor",
  "type": "object"
}

{
  "$defs": {
    "AcquisitionKind": {
      "enum": [
        "work_bundle",
        "package",
        "git_snapshot",
        "local_import",
        "remote_catalog",
        "foreign_binding"
      ],
      "type": "string"
    },
    "AcquisitionRecord": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/AcquisitionKind"
        },
        "provenance_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactDescriptor"
          },
          "type": "array"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "update_channel": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ArtifactDescriptor": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "artifact_type_uri": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_type_uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "type": "object"
    },
    "AssemblyBinding": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "type": "object"
        },
        "binding_id": {
          "type": "string"
        },
        "consumer": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "phase": {
          "$ref": "#/$defs/BindingPhase"
        },
        "provider": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "transport_policy": {
          "allOf": [
            {
              "$ref": "#/$defs/TransportPolicy"
            }
          ],
          "default": {
            "requirements": {
              "large_payload": false,
              "local_only": false,
              "ordered": false,
              "reliable": false,
              "same_process": false,
              "shared_memory_allowed": false
            }
          }
        }
      },
      "required": [
        "binding_id",
        "consumer",
        "phase",
        "provider"
      ],
      "type": "object"
    },
    "AssemblyNode": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "type": "object"
        },
        "configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            {
              "type": "null"
            }
          ]
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/PortDescriptor"
          },
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/AssemblyNodeSource"
        }
      },
      "required": [
        "node_id",
        "source"
      ],
      "type": "object"
    },
    "AssemblyNodeSource": {
      "oneOf": [
        {
          "properties": {
            "component": {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            "kind": {
              "enum": [
                "component"
              ],
              "type": "string"
            }
          },
          "required": [
            "component",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "assembly": {
              "$ref": "#/$defs/ArtifactDescriptor"
            },
            "kind": {
              "enum": [
                "assembly"
              ],
              "type": "string"
            }
          },
          "required": [
            "assembly",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "AssemblyPortExposure": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "type": "object"
        },
        "direction": {
          "$ref": "#/$defs/PortDirection"
        },
        "port_id": {
          "$ref": "#/$defs/PortId"
        },
        "target": {
          "$ref": "#/$defs/PortEndpoint"
        }
      },
      "required": [
        "direction",
        "port_id",
        "target"
      ],
      "type": "object"
    },
    "AvailabilityPolicy": {
      "enum": [
        "required",
        "degraded_without",
        "optional"
      ],
      "type": "string"
    },
    "BackupPolicy": {
      "enum": [
        "required",
        "allowed",
        "forbidden"
      ],
      "type": "string"
    },
    "BindingLock": {
      "properties": {
        "binding_id": {
          "type": "string"
        },
        "consumer": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "phase": {
          "$ref": "#/$defs/BindingPhase"
        },
        "provider": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "provider_component": {
          "$ref": "#/$defs/ArtifactDescriptor"
        },
        "transport": {
          "$ref": "#/$defs/SelectedTransport"
        }
      },
      "required": [
        "binding_id",
        "consumer",
        "phase",
        "provider",
        "provider_component",
        "transport"
      ],
      "type": "object"
    },
    "BindingPhase": {
      "enum": [
        "authoring",
        "installation",
        "launch",
        "runtime"
      ],
      "type": "string"
    },
    "ComponentTrustClass": {
      "enum": [
        "sandboxed_component",
        "isolated_process",
        "remote_boundary",
        "trusted_native",
        "static_resource",
        "foreign_capsule"
      ],
      "type": "string"
    },
    "EffectClass": {
      "enum": [
        "pure",
        "deterministic_stateful",
        "recorded_nondeterministic",
        "external_effecting",
        "realtime_best_effort"
      ],
      "type": "string"
    },
    "InstallationChange_for_ArtifactDescriptor": {
      "oneOf": [
        {
          "additionalProperties": false,
